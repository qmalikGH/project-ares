// Project Ares — Prisma Schema v0.1
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Auth (NextAuth.js)
// ============================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // Domain
  visions        Vision[]
  annualGoals    AnnualGoal[]
  goals          Goal[]
  macrocycles    Macrocycle[]
  workouts       Workout[]
  sensorData     DailySensorData[]
  conversations  AIConversation[]
  garminSyncLogs GarminSyncLog[]
  notifications  Notification[]
  exerciseLogs   ExerciseLog[]
  settings       UserSettings?
  coachingLogs   CoachingLog[]
  mealPlans      MealPlan[]
  nutritionLogs  DailyNutritionLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Domain: Goal Hierarchy (Sprint v0.14)
// ============================================
model Vision {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("active") // active | archived

  // Ziel-Dimensionen als JSON — flexibel erweiterbar
  // Schema: GoalDimensions from lib/coach-engine/types.ts
  targets     Json
  timeHorizon String   @default("3-5 years") // human-readable
  notes       String?

  annualGoals AnnualGoal[]

  @@index([userId, status])
}

model AnnualGoal {
  id          String   @id @default(cuid())
  visionId    String
  vision      Vision   @relation(fields: [visionId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      String   @default("active") // active | completed | archived

  // Ziel-Dimensionen — gleiches Schema wie Vision
  targets     Json
  startDate   DateTime
  targetDate  DateTime
  notes       String?

  // Verknüpfung zu Makrozyklen die diesem Jahresziel dienen
  macrocycles Macrocycle[]

  // Evaluation am Ende
  evaluation  Json?      // { dimensions: [{ name, start, end, target, gap, verdict }] }
  evaluatedAt DateTime?

  @@index([userId, status])
}

// ============================================
// Domain: Goal (legacy single-goal model, kept for back-compat)
// ============================================
model Goal {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  primaryType  String // "5k_time" | "10k_time" | etc.
  currentValue Json // {time: "24:30", date: "2026-04-26"}
  targetValue  Json // {time: "22:00", date: "2026-09-15"}
  modality     String // "hybrid" | "run_only" | "strength_only"
  constraints  Json // [{type: "patellar_tendinopathy", severity: "active"}]
  preferences  Json // {strength_per_week: 3, max_training_days: 6}

  startDate  DateTime
  targetDate DateTime
  status     String   @default("active") // "active" | "completed" | "abandoned"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  macrocycles Macrocycle[]
}

// ============================================
// Domain: Periodization
// ============================================
model Macrocycle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id])

  // Sprint v0.14: Verknüpfung zum Jahresziel
  annualGoalId String?
  annualGoal   AnnualGoal? @relation(fields: [annualGoalId], references: [id])

  // Sprint v0.14: Prioritäts-Modus für diesen Zyklus
  // "balanced" | "strength_focus" | "endurance_focus" | "recomp"
  focusMode    String?     @default("balanced")

  // Sprint v0.14: Evaluation am Ende des Zyklus
  evaluation   Json?
  evaluatedAt  DateTime?

  startDate  DateTime
  endDate    DateTime
  totalWeeks Int // 20

  phases Phase[]

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Phase {
  id           String     @id @default(cuid())
  macrocycleId String
  macrocycle   Macrocycle @relation(fields: [macrocycleId], references: [id])

  blockNumber    Int // 1-5
  name           String // "ACCUMULATION_AEROBIC_BASE", etc.
  startDate      DateTime
  plannedEndDate DateTime
  actualEndDate  DateTime?

  durationWeeks Int // 4 typically, can be extended
  config        Json // PhaseConfig from Science-Doc Kap 9

  // Outcome markers
  performanceMarker Json? // {targetVdot, achievedVdot, ...}
  blockReviewId     String?      @unique
  blockReview       BlockReview? @relation(fields: [blockReviewId], references: [id])

  // User-Override Tracking (Q4)
  userOverrideRationale String?
  userOverrideAt        DateTime?

  status String @default("active") // "active" | "completed" | "extended"

  weeklyPlans WeeklyPlan[]
}

model WeeklyPlan {
  id      String @id @default(cuid())
  phaseId String
  phase   Phase  @relation(fields: [phaseId], references: [id])

  weekNumber Int // 1-20 within macrocycle
  startDate  DateTime
  endDate    DateTime

  plannedSessions Json // SessionPlan[] for the week (7 days)

  createdAt DateTime @default(now())
}

// ============================================
// Domain: Workouts (planned + executed)
// ============================================
model Workout {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date DateTime
  type String // "easy_run" | "threshold_run" | "strength_a" | etc.

  // Plan (was geplant war)
  plannedSession Json // SessionPlan

  // Modulation (was die Engine angepasst hat)
  modulationApplied Boolean @default(false)
  modulations       Json? // string[] of modifications
  modulationReason  String?

  // Execution (was tatsächlich passiert ist)
  status          String @default("planned") // "planned" | "in_progress" | "completed" | "skipped"
  executedSession Json? // ExecutedSession (real durations, paces, loads)

  // Post-session feedback
  rpe               Int? // 0-10 sRPE
  durationActualMin Int?
  notes             String?

  // Linkage to Garmin data
  garminActivityId String?

  // Garmin Workout Push (Sprint v0.9) — tracks pushed-to-watch state.
  // Set by /api/cron/garmin-workout-push (vorabend) or manual sync.
  garminWorkoutId          String?
  garminScheduledWorkoutId String?
  garminScheduledAt        DateTime?
  garminPushStatus         String? // "synced" | "failed" | "removed"
  garminPushError          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Domain: Sensor Data
// ============================================
model DailySensorData {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  date DateTime @unique // one entry per day per user

  // From Garmin (auto-synced)
  garmin           Json? // {hrv_status, hrv_rmssd, sleep_score, sleep_duration_min, body_battery_morning, rhr}
  garminLastSyncAt DateTime?

  // From User (morning input)
  userMorning Json? // {subjective_recovery: 1-10, morning_stiffness: 1-10, stairs_score: 1-10}

  // Computed scores (cached, recomputed when inputs change)
  readinessScore      Int?
  readinessBand       String? // "GREEN" | "YELLOW" | "ORANGE" | "RED"
  readinessComponents Json?

  loadMetrics Json? // {daily_load_au, acute_7d, chronic_28d, acwr_rolling, acwr_ewma, band}

  // Sprint v0.15: Body weight tracking (manual input, scale-ready)
  bodyWeightKg     Float?   // Körpergewicht in kg
  bodyWeightSource String?  // "manual" | "scale" | "garmin"

  // Sprint v0.16 Phase A2: extended Garmin wellness columns. Top-level (not in
  // `garmin` JSON) so they are queryable for the nutrition adjustment engine.
  totalKilocalories  Int?    // TDEE — total daily energy expenditure
  activeKilocalories Int?    // Active calories (training + NEAT)
  bmrKilocalories    Int?    // Basal metabolic rate
  bodyBatteryEnd     Int?    // 0-100 at end of day
  averageStress      Float?  // 0-100 average stress level

  kneeScore    Int? // computed from morning_stiffness + stairs + last_training
  therapyPhase String? // "REACTIVE" | "DISREPAIR" | "REMODELING" | "SPORT_SPECIFIC"

  computedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Domain: AI Coach
// ============================================
model AIConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type       String // "onboarding" | "daily_explanation" | "free_chat" | "weekly_review" | "block_review"
  contextRef String? // ID of related entity (workout, weekplan, block-review)

  messages Json // Message[] in Anthropic format

  modelUsed    String // "claude-opus-4-7" | "claude-sonnet-4-6"
  tokensInput  Int?
  tokensOutput Int?
  costUsd      Decimal? @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Domain: Garmin Sync Health Tracking (Q1)
// ============================================
model GarminSyncLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  syncedAt DateTime @default(now())
  status   String // "SUCCESS" | "FAILURE" | "PARTIAL"

  // Detailed status
  hrvSyncOk         Boolean
  sleepSyncOk       Boolean
  bodyBatterySyncOk Boolean
  rhrSyncOk         Boolean
  activitiesSyncOk  Boolean

  errorType    String? // "AUTH_FAILURE" | "RATE_LIMIT" | "API_CHANGED" | "NETWORK" | "PARSE_ERROR"
  errorMessage String? @db.Text
  retryCount   Int     @default(0)

  // Health-Check Notification State
  notificationSent Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, syncedAt(sort: Desc)])
}

// ============================================
// Domain: Notifications
// ============================================
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type     String // "GARMIN_SYNC_FAILURE" | "VDOT_CALIBRATED" | "BLOCK_REVIEW_DUE" | "TIME_TRIAL_TODAY"
  title    String
  message  String @db.Text
  severity String @default("INFO") // "INFO" | "WARNING" | "CRITICAL"

  read   Boolean   @default(false)
  readAt DateTime?

  // Optional action link (z.B. settings page für Sync-Failures)
  actionUrl String?

  createdAt DateTime @default(now())

  @@index([userId, read, createdAt(sort: Desc)])
}

// ============================================
// Domain: Block Reviews
// ============================================
model BlockReview {
  id String @id @default(cuid())

  performanceMarkerResult Json // {test: "5k_TT", target: 23:30, achieved: 23:45}
  actualTID               Json // {z1: 75, z2: 22, z3: 3} (% actual)
  averageACWR             Decimal @db.Decimal(4, 2)
  averageReadiness        Int
  kneeScoreTrend          String // "stable" | "improving" | "declining"
  missedSessionsCount     Int

  decision          String // "PROCEED" | "EXTEND_PHASE" | "ADJUST_PHASE" | "DEFER"
  decisionRationale String @db.Text

  aiSummary String? @db.Text // generated by AI-Coach

  phase Phase?

  createdAt DateTime @default(now())
}

// ============================================
// User Settings (added in v0.5)
// ============================================
model UserSettings {
  userId                  String    @id
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Garmin override (v0.5: plaintext; v0.6: encrypt at rest)
  garminUsernameOverride  String?
  garminPasswordOverride  String?

  // AI Coach
  aiCoachEnabled          Boolean   @default(true)
  aiModelPrimaryOverride  String?

  // VDOT override
  vdotOverride            Int?
  vdotOverrideAt          DateTime?
  vdotOverrideRationale   String?   @db.Text

  // HR Zones (Karvonen HRR — Sprint v0.6)
  hrMax                   Int?
  hrRest                  Int?
  hrZonesUpdatedAt        DateTime?
  hrZonesSource           String?   // "manual" | "garmin_lthr" | "field_test"

  // Garmin Workout Push (Sprint v0.9) — opt-in toggle. When true, daily cron
  // pushes tomorrow's run-workouts to Garmin Connect, surfaced on FR165.
  garminWorkoutPushEnabled Boolean   @default(false)

  // Schedule constraints (Sprint v0.10) — drive planWeekSchedule.
  // Stored ISO-style: 1=Mon..7=Sun, easy to read in DB tools.
  // Default Q: Wed (3) + Sun (7) forced rest, Sat (6) long run.
  forcedRestDays           Int[]     @default([3, 7])
  preferredLongRunDay      Int       @default(6)

  // 1RM Estimates (Sprint v0.11) — user inputs initial values, engine
  // auto-updates via Epley from training data. JSON: { "Hex Bar Deadlift": 120, ... }
  exerciseMaxEstimates    Json?
  exerciseMaxSource       String?   // "manual" | "epley_auto" | "5rm_test"
  exerciseMaxUpdatedAt    DateTime?

  // Therapy-Phase manual override (Sprint v0.12) — when set, wins over the
  // daily-derived DailySensorData.therapyPhase at strength-plan generation.
  // Drives wallSitNeeded (only REACTIVE/DISREPAIR insert Wall Sit).
  // Values: REACTIVE | DISREPAIR | REMODELING | SPORT_SPECIFIC
  therapyPhaseOverride    String?

  // Sprint v0.16: Health context maintained by the external AI coach via
  // /api/coaching-update. activeInjuries are surfaced in coaching-export
  // and drive plan modulation. preventionExercises are suggested daily.
  activeInjuries          String[]  @default([])
  preventionExercises     String[]  @default([])

  // Sprint v0.15: Body weight tracking — cached 7d average for ×BW display
  currentWeightKg          Float?    // 7-Tage-Durchschnitt
  currentWeightUpdatedAt   DateTime? // Wann zuletzt berechnet
  targetWeightKg           Float?    // Zielgewicht (aus AnnualGoal/Vision)

  // Notifications (per-type toggle)
  notificationPrefs       Json?

  // Travel-aware timezone (Sprint v0.16) — IANA name like "America/New_York".
  // Populated by TimezoneCookieSetter via PATCH /api/settings/timezone on
  // every browser mount. Crons read from here (no request context = no cookie).
  // Null falls back to USER_TIMEZONE env (Europe/Berlin default).
  timezone                String?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// ExerciseLog (Sprint v0.11) — per-set training-data log. Feeds the rolling
// median 1RM estimator (lib/coach-engine/strength-coach/one-rm.ts) and the
// block-transition review (proposeOneRMUpdates).
//
// Written from /api/sessions/complete when the user logs actual weight + reps
// for a strength exercise. Read during W4 deload to propose 1RM updates.
model ExerciseLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseName    String
  weightKg        Float
  repsCompleted   Int
  rpe             Float?
  estimatedOneRM  Float
  date            DateTime
  createdAt       DateTime @default(now())

  @@index([userId, exerciseName, date(sort: Desc)])
}

// CoachingLog (Sprint v0.16) — audit trail for the external AI coach's
// write actions via POST /api/coaching-update. Every state change carries
// a `reason` so Q can review what the coach changed and why.
model CoachingLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // "updateTherapyPhase" | "updateActiveInjuries" | ...
  data      Json     // payload sent by the coach
  reason    String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// ============================================
// Nutrition (Sprint v0.16 Part B)
// ============================================
// MealPlan — one active plan per user, archived when the coach replaces it.
// Drives the static meal architecture (4 day-types × slots) and the daily
// adjustment engine. Calibration status flips pending → calibrated once the
// 14-day Garmin TDEE rolling averages stabilize.
model MealPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // "Block 1 Standard"
  status    String   @default("active") // "active" | "archived"

  // Global settings (shared across all DayPlans)
  budgetPerDay    Float @default(15.0)
  proteinTarget   Int   // grams/day, e.g. 190
  deficitKcal     Int   @default(500)

  // Calibration lifecycle
  calibrationStatus String    @default("pending") // "pending" | "collecting" | "calibrated"
  calibratedAt      DateTime?

  dayPlans       DayPlan[]
  dayTypeConfigs DayTypeConfig[]
  computedSlots  ComputedMealSlot[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId, status])
}

// DayPlan — one row per (MealPlan × dayType). The slot structure is JSON so
// the coach can patch individual slots without schema migrations. Calibrated
// targets overwrite the initial estimates from B2.2.
model DayPlan {
  id         String  @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  dayType String // "strength_run" | "threshold" | "long_run" | "rest"

  // Calorie & macro targets — pre-calibration these are estimates from
  // INITIAL_TARGETS (Phase B2.2); post-calibration they come from rolling
  // 14-day Garmin TDEE averages.
  tdeeEstimate  Int
  calorieTarget Int
  proteinG      Int
  carbsG        Int
  fatG          Int

  // Slot structure — see lib/nutrition/types.ts MealSlots
  slots Json

  @@unique([mealPlanId, dayType])
}

// DailyNutritionLog — one row per (user × calendar date). Records what the
// plan was and any next-day adjustments the engine applied. Used by the
// coaching-export to surface the rolling 7-day nutrition story.
model DailyNutritionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date

  dayType       String
  calorieTarget Int

  // Garmin TDEE for `date` (mirror from DailySensorData.totalKilocalories
  // for query convenience — no FK to keep this audit-style log decoupled).
  garminTDEE Int?

  // Adjustment for THIS day, computed from yesterday's delta. JSON: see
  // lib/nutrition/types.ts DailyAdjustment.
  adjustment Json?

  followed Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// DayTypeConfig — one row per (MealPlan × dayType). Persists the nutrition
// engine config that was previously a code constant. After initial seed from
// DAY_TYPE_CONFIGS, the DB is the source of truth. RecipeTemplates stay in code.
model DayTypeConfig {
  id                 String   @id @default(cuid())
  planId             String
  plan               MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayType            String   // "strength_run" | "threshold" | "long_run" | "rest"
  calorieTarget      Int
  proteinG           Int
  carbsG             Int
  fatG               Int
  fixedSlots         Json     // FixedSlotDef structure (stable, rarely edited)
  mainMealRecipeId   String   // → RecipeTemplate.id (code constant)
  mainMealRatio      Float    // e.g. 0.55
  dinnerRecipeId     String   // → RecipeTemplate.id
  dinnerRatio        Float    // e.g. 0.45
  flexDessertEnabled Boolean  @default(true)
  // v1.2 — Training timing + TDEE tracking
  tdeeEstimate       Int?     // Garmin-calibrated TDEE; calorieTarget = tdeeEstimate - deficit
  trainingWindow     String   @default("none") // "morning" | "evening" | "both" | "none"
  dinnerNeedsCarbs   Boolean  @default(false) // true when dinner = post-workout meal
  updatedAt          DateTime @updatedAt

  @@unique([planId, dayType])
}

// ComputedMealSlot — pre-computed slot data written by cascadeNutritionUpdate().
// Never edited directly — only deleted + re-created in a transaction by the cascade.
model ComputedMealSlot {
  id           String   @id @default(cuid())
  planId       String
  plan         MealPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayType      String
  slotName     String   // "morning" | "preTraining" | "mainMeal" | "dinner" | ...
  recipeId     String?
  recipeName   String?
  items        Json     // ScaledComponent[] or FixedSlotItem[]
  totalKcal    Float
  totalProtein Float
  totalCarbs   Float
  totalFat     Float
  totalCost    Float
  computedAt   DateTime @default(now())

  @@unique([planId, dayType, slotName])
}
