# ─── Database (PostgreSQL) ─────────────────────────────────────────────
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://user:password@host:5432/ares"
# Direct (non-pooled) connection string used by Prisma migrations
DIRECT_URL="postgresql://user:password@host:5432/ares"

# ─── AI coaching (Anthropic Claude) ────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
# Model routing (optional — sensible defaults apply if unset)
AI_MODEL_PRIMARY=""
AI_MODEL_FALLBACK=""
# Feature flag: turn the AI coach on/off
ENABLE_AI_COACH="true"

# ─── Garmin Connect ────────────────────────────────────────────────────
GARMIN_USERNAME=""
GARMIN_PASSWORD=""

# ─── Scheduled jobs & exports ──────────────────────────────────────────
# Shared secret protecting the /api/cron endpoints
CRON_SECRET=""
# Token protecting the coaching-export endpoint
COACHING_EXPORT_TOKEN=""

# ─── Misc ──────────────────────────────────────────────────────────────
# IANA timezone used for day boundaries, e.g. Europe/Berlin
USER_TIMEZONE="Europe/Berlin"
